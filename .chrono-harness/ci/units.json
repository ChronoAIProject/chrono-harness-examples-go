{
  "schema": "chrono-github-units/v1",
  "collection": {
    "schema": "chrono-github-ci/v4",
    "workflow_path": ".github/workflows/chrono-ci.yml",
    "name": "chrono / collection",
    "runs_on": "ubuntu-24.04",
    "push_branches": [
      "dev"
    ],
    "pull_request_branches": [
      "dev",
      "integration/**"
    ],
    "branch_creation_base_ref": "refs/heads/dev",
    "checkout_action": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
    "upload_artifact_action": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
    "timeout_minutes": 45,
    "bootstrap": [
      "python3",
      ".chrono-harness/bootstrap.py",
      ".",
      "--profile",
      "collection"
    ],
    "runner": ".chrono-harness/bin/chrono-harness",
    "generator": ".chrono-harness/bin/chrono-ci",
    "check_config": ".chrono-harness/ci/check.json",
    "context_path": ".chrono-harness/state/collection/context.json",
    "artifact_directory": ".chrono-harness/state/collection/",
    "facts_config": ".chrono-harness/config.json",
    "include_hidden_files": true
  },
  "units": {
    "rates": {
      "name": "chrono / rates",
      "runs_on": "ubuntu-24.04",
      "timeout_minutes": 30,
      "bootstrap": [
        "python3",
        ".chrono-harness/bootstrap.py",
        ".",
        "--profile",
        "rates"
      ],
      "context_path": ".chrono-harness/state/units/rates/context.json",
      "artifact_directory": ".chrono-harness/state/units/rates/"
    },
    "harness": {
      "name": "chrono / harness",
      "runs_on": "ubuntu-24.04",
      "timeout_minutes": 30,
      "bootstrap": [
        "python3",
        ".chrono-harness/bootstrap.py",
        ".",
        "--profile",
        "harness"
      ],
      "context_path": ".chrono-harness/state/units/harness/context.json",
      "artifact_directory": ".chrono-harness/state/units/harness/"
    }
  },
  "gather": {
    "program": "gh",
    "inherit_environment": [
      "PATH",
      "HOME",
      "GH_TOKEN"
    ],
    "credential_environment": [
      "GH_TOKEN"
    ],
    "environment": {},
    "timeout_seconds": 60,
    "output_limit_bytes": 8388608,
    "manifest_path": ".chrono-harness/state/collection/manifest.json",
    "download_directory": ".chrono-harness/state/collection/downloads/",
    "report_path": ".chrono-harness/state/collection/gather.json"
  },
  "job_gating": {
    "schema": "chrono-job-gating/v1",
    "detector": {
      "runs_on": "ubuntu-24.04",
      "timeout_minutes": 45,
      "bootstrap": [
        "python3",
        ".chrono-harness/bootstrap.py",
        ".",
        "--profile",
        "collection"
      ],
      "sparse_checkout": [
        ".chrono-harness/",
        ".github/workflows/chrono-ci.yml"
      ]
    }
  },
  "persistent_cache": {
    "schema": "chrono-github-cache/v1",
    "restore_action": "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830",
    "save_action": "actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830",
    "save_on_push_only": true,
    "jobs": {},
    "downloads": {
      "schema": "chrono-github-downloads/v1",
      "namespace": "release-tools",
      "artifact_registry": ".chrono-harness/git/linux.json",
      "environment": {},
      "entries": {
        "tools": {
          "owner": "repository",
          "need": "复用固定 Release 的工具。",
          "output_use": "原安装器校验大小、摘要和可执行权限，从固定 Release 补齐工具。",
          "paths": [
            ".chrono-harness/bin/"
          ],
          "compatibility_files": [
            ".chrono-harness/distribution.json"
          ],
          "source_files": [
            ".chrono-harness/install.sh"
          ],
          "consumers": [
            "detect",
            "unit_rates",
            "unit_harness",
            "aggregate"
          ],
          "save_job": "detect"
        },
        "sdk.rates": {
          "owner": "repository",
          "need": "复用此业务单元使用的固定版本 SDK 压缩档。",
          "output_use": "bootstrap 校验归档摘要，按登记的下载地址恢复缺失或损坏的归档。",
          "paths": [
            ".chrono-harness/cache/downloads/"
          ],
          "compatibility_files": [
            ".chrono-harness/sdk/go.json"
          ],
          "source_files": [
            ".chrono-harness/bootstrap.py",
            ".chrono-harness/bootstrap.json"
          ],
          "consumers": [
            "unit_rates"
          ],
          "save_job": "unit_rates"
        }
      }
    }
  }
}
