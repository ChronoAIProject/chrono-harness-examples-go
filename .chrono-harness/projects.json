{
  "schema_version": 1,
  "status": "active",
  "owners": [
    "repository",
    "bootstrap",
    "bootstrap-tests",
    "rates",
    "rates-tests",
    "native-lifecycle",
    "native-lifecycle-tests"
  ],
  "projects": [
    {
      "id": "rates",
      "kind": "production",
      "test_project": "rates-tests",
      "actions": {
        "build": {
          "operation": "build.rates",
          "tool": "go",
          "argv": [
            "-C",
            "engine/rates",
            "build",
            "-mod=readonly",
            "."
          ]
        }
      }
    },
    {
      "id": "rates-tests",
      "kind": "test",
      "tests_for": "rates",
      "actions": {
        "execute": {
          "operation": "test.rates",
          "tool": "go",
          "argv": [
            "-C",
            "verification/contracts",
            "test",
            "-mod=readonly",
            "-count=1",
            "-v",
            "."
          ]
        }
      }
    }
  ],
  "scripts": [
    {
      "id": "bootstrap",
      "path": ".chrono-harness/bootstrap.py",
      "test_script": "bootstrap-tests",
      "actions": {
        "execute": {
          "operation": "bootstrap",
          "tool": "python3",
          "argv": [
            ".chrono-harness/bootstrap.py",
            "."
          ]
        },
        "check": {
          "operation": "ci.verify",
          "tool": "chrono-ci",
          "argv": [
            "verify",
            "--host-root",
            ".",
            "--config",
            ".chrono-harness/ci/units.json"
          ]
        },
        "generate": {
          "operation": "instructions.generate",
          "tool": "chrono-instructions",
          "argv": [
            "generate",
            "--host-root",
            "."
          ]
        }
      }
    },
    {
      "id": "bootstrap-tests",
      "path": ".chrono-harness/bootstrap_test.py",
      "tests_for": "bootstrap",
      "actions": {
        "execute": {
          "operation": "test.bootstrap",
          "tool": "python3",
          "argv": [
            "-B",
            ".chrono-harness/bootstrap_test.py"
          ]
        }
      }
    },
    {
      "id": "native-lifecycle",
      "path": ".chrono-harness/experiments/native-lifecycle/probe.py",
      "test_script": "native-lifecycle-tests",
      "actions": {
        "capture": {
          "operation": "native.capture",
          "tool": "python3",
          "argv": [
            "-B",
            ".chrono-harness/experiments/native-lifecycle/probe.py",
            "capture",
            "--repo-dir",
            "{repo}",
            "--event",
            "{event}",
            "--context",
            "{context}",
            "--output",
            "{output}"
          ]
        },
        "verify": {
          "operation": "native.verify",
          "tool": "python3",
          "argv": [
            "-B",
            ".chrono-harness/experiments/native-lifecycle/probe.py",
            "verify",
            "--repo-dir",
            "{repo}",
            "--event",
            "{event}",
            "--context",
            "{context}",
            "--expect",
            "{expect}",
            "--output",
            "{output}"
          ]
        },
        "project": {
          "operation": "native.project",
          "tool": "python3",
          "argv": [
            "-B",
            ".chrono-harness/experiments/native-lifecycle/probe.py",
            "project",
            "--host-root",
            "."
          ]
        }
      }
    },
    {
      "id": "native-lifecycle-tests",
      "path": ".chrono-harness/experiments/native-lifecycle/probe_test.py",
      "tests_for": "native-lifecycle",
      "actions": {
        "execute": {
          "operation": "test.native-lifecycle",
          "tool": "python3",
          "argv": [
            "-B",
            ".chrono-harness/experiments/native-lifecycle/probe_test.py"
          ]
        }
      }
    }
  ]
}
